# DeepSeek API Configuration
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-string
JWT_EXPIRES_IN=30d

# CORS (逗号分隔的允许来源)
# CORS_ORIGINS=https://your-frontend-domain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL_SECONDS=3600

# Douban Proxy
DOUBAN_PROXY_URL=https://douban-proxy.203065.xyz

# AI Model Configuration (optional)
# LITELLM_BASE_URL=http://your-litellm-server:4000/v1
# LITELLM_API_KEY=your-litellm-key
# LITELLM_MODEL=deepseek-chat
# LITELLM_FALLBACK_MODEL=deepseek-coder
